rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 04-android-windows-bridge.md 3: 폰 앱은 자기 uid 문서 안쪽만 읽고 쓸 수 있다.
    // PC(LocalAssistant.Engine.FirestoreBridge)는 서비스 계정으로 접근하므로
    // 이 규칙을 거치지 않는다(관리자 권한).
    match /conversations/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
